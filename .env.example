# HTTP Server
OWAS_HOST=0.0.0.0
OWAS_PORT=8080
GIN_MODE=release
OWAS_READ_TIMEOUT=15s
OWAS_WRITE_TIMEOUT=30s
OWAS_IDLE_TIMEOUT=60s
OWAS_SHUTDOWN_TIMEOUT=10s

# Upstream Endpoints & Timeout
OWAS_APPSTORE_BASE_URL=https://watch-cn.store.heytapmobi.com
OWAS_HEALTH_CLOUD_BASE_URL=https://sport.health.heytapmobi.com
OWAS_UPSTREAM_TIMEOUT=20s

# Default Simulated OPPO Watch Device Profile
OWAS_DEFAULT_BRAND=OPPO
OWAS_DEFAULT_PRODUCT=OWW251
OWAS_DEFAULT_MODEL=OWW251
OWAS_DEFAULT_SDK_INT=30
OWAS_DEFAULT_ANDROID_RELEASE=11
OWAS_DEFAULT_HEY_RELEASE=4.0
OWAS_DEFAULT_COLOR_OS_VER=16
OWAS_DEFAULT_SYS_VER=OWW251_11_A.319
OWAS_DEFAULT_LOCALE=zh-CN;CN
OWAS_DEFAULT_SUPPORT=android-oppo
OWAS_DEFAULT_LINKAGE=0
OWAS_DEFAULT_PLAT_CODE=0
OWAS_DEFAULT_INSTANT_SW_CLOSE=0
OWAS_DEFAULT_WATCH_TYPE=2
OWAS_DEFAULT_TOKEN=
